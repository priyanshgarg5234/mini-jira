NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/mini-jira
CLIENT_URL=http://localhost:5173

# Access tokens (JWT). Use a long random value: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret-at-least-32-chars
ACCESS_TOKEN_TTL=15m
# Refresh tokens are random, stored hashed in MongoDB, rotated on every use.
REFRESH_TOKEN_TTL_DAYS=7
# Set to true when serving over HTTPS (always in production).
COOKIE_SECURE=false

# Calendar used for "today" in due-date validation.
APP_TIMEZONE=Asia/Kolkata
LOG_LEVEL=debug

# Email. Leave SMTP_HOST empty to log emails instead of sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Mini Jira <no-reply@minijira.dev>"

# Used by `npm run create-admin`
ADMIN_NAME=Workspace Admin
ADMIN_EMAIL=admin@minijira.dev
ADMIN_PASSWORD=
